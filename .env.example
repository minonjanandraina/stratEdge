# ── Environnement ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=changez-moi-en-production-valeur-aleatoire-longue

# ── Domaine ───────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com
CORS_ALLOWED_ORIGINS=https://votredomaine.com
SITE_URL=https://votredomaine.com

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DB_NAME=stratedge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:mot-de-passe-redis@localhost:6379/0

# ── Email SMTP ────────────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@votredomaine.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=mot-de-passe-smtp
EMAIL_USE_TLS=True

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
